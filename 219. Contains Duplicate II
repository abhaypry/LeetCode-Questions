class Solution {
public:
    bool containsNearbyDuplicate(vector<int>& nums, int k) {

        int n=nums.size();
        int start=0,end=0;
        unordered_map<int,int>mp;
        while(end<n)
        {
            mp[nums[end]]++;
            while(mp[nums[end]]==2)
            {
                if(abs(end-start)<=k)
                {
                    return true;
                }
                mp[nums[start]]--;
                start++;
            }
            
            end++;
        }
        return false;
    }
};

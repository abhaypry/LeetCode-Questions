class Solution {
public:
    vector<vector<int>> matrixReshape(vector<vector<int>>& mat, int r, int c) {
        if((mat.size() * mat[0].size()) != r * c) return mat;
        vector<vector<int>> ans(r, vector<int>(c,0));
        int n,p = 0,q = 0;
        for(int i = 0; i < r; i++){
            for(int j = 0; j < c; j++){
                n = mat[p][q];
                ans[i][j] = n;
                q++;
                if(q >= mat[0].size()){
                    p++;
                    q = 0;
                }
            }
        }
        return ans;
    }
};


class Solution {
public:
    int findPoisonedDuration(vector<int>& timeSeries, int duration) {
        int poisonedSeconds = 0;
        int prevEndTime = 0;

        for(int time : timeSeries) {
            int currEndTime = time + duration;
            poisonedSeconds += min(currEndTime - prevEndTime, duration);
            prevEndTime = currEndTime;
        }

        return poisonedSeconds;
    }
};

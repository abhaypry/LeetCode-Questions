class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {
        int start = 0;
        int end = 0;
        double sum = 0;
        double Max_avg = INT_MIN;

        while(end <= nums.size() - 1){
            while(end - start + 1 <= k){
                sum += nums[end++];
            }
            double average = sum / k;
            Max_avg = max(Max_avg , average);

            sum -= nums[end - k];
            start++;
        }
        return Max_avg;
    }
};

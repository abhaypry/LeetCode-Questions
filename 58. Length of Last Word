class Solution {
public:
    int lengthOfLastWord(string s) {
        
        int ans = 0;
        int n = s.length();
        for(int i = n-1; i >= 0; i--) {
            if(s[i] == ' ' && ans == 0) {
                continue; 
            }
            else if(s[i] != ' ') {
                ans++;
            }
            else {
                break;
            }
        }

        return ans;
    }
};
